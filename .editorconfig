root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,ipynb,toml,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Caption fixtures reproduce real files byte for byte, including lines that hold
# a single space (part of YouTube's rolling-caption format).
[tests/fixtures/**]
trim_trailing_whitespace = false
insert_final_newline = false
